  tensor_load_to_lds s[0:3], s[4:11], s[12:15], s[16:19]           -> 	tensor_load_to_lds s[0:3], s[4:11], s[12:15], s[16:19] ; encoding: [0x01,0x00,0x71,0xd0,0
  tensor_load_to_lds s[0:7], s[8:15], s[16:23], s[24:31]           -> <stdin>:1:20: error: invalid operand for instruction
