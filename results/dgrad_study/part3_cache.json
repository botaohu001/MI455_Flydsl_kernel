{
 "tests_torch": [
  {
   "test": "cache hit is the same object as the miss that filled it",
   "pass_": true,
   "note": ""
  },
  {
   "test": "cached transpose is bitwise equal to a fresh hoist",
   "pass_": true,
   "note": ""
  },
  {
   "test": "cached transpose is bitwise equal to upstream make_nn_weight_nt",
   "pass_": true,
   "note": ""
  },
  {
   "test": "dgrad through the cache is bitwise equal to dgrad through a hoist",
   "pass_": true,
   "note": ""
  },
  {
   "test": "hit/miss accounting",
   "pass_": true,
   "note": "{'entries': 1, 'hits': 2, 'misses': 1, 'invalidations': 0, 'evictions': 0}"
  },
  {
   "test": "in-place add_ bumps _version",
   "pass_": true,
   "note": "0 -> 1"
  },
  {
   "test": "cache missed after the weight changed",
   "pass_": true,
   "note": ""
  },
  {
   "test": "refreshed entry matches the new weight",
   "pass_": true,
   "note": ""
  },
  {
   "test": "dgrad after invalidation is bitwise correct",
   "pass_": true,
   "note": ""
  },
  {
   "test": "a cache that ignored _version would have been wrong here",
   "pass_": true,
   "note": "the stale buffer really does differ from the correct one"
  },
  {
   "test": "three live weights each get their own entry",
   "pass_": true,
   "note": ""
  },
  {
   "test": "their transposes are pairwise different",
   "pass_": true,
   "note": ""
  },
  {
   "test": "entry is evicted when the weight is freed",
   "pass_": true,
   "note": "4 -> 5 -> 4"
  },
  {
   "test": "data_ptr changed after set_()",
   "pass_": true,
   "note": ""
  },
  {
   "test": "set_() to new storage invalidates the entry",
   "pass_": true,
   "note": ""
  },
  {
   "test": "entry after set_() is correct",
   "pass_": true,
   "note": ""
  },
  {
   "test": "fused AdamW changed the parameter",
   "pass_": true,
   "note": "parameter values did change"
  },
  {
   "test": "HAZARD: _version-keyed cache serves a stale transpose after fused AdamW",
   "pass_": true,
   "note": "this is a FAIL for the cache design, reported as a finding"
  },
  {
   "test": "...and the resulting dgrad is numerically wrong",
   "pass_": true,
   "note": "rel diff 9.994e-02"
  }
 ],
